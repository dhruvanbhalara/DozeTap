# ==============================================================================
# DozeTap Local Keystore Configuration
# Copy this file to 'keystore.properties' and fill in your actual credentials.
# 'keystore.properties' is gitignored and will never be committed.
# ==============================================================================

# --- DEBUG KEYSTORE (Used for all debug variants) ---
# DEBUG_KEYSTORE_FILE=debug-keystore.jks
# DEBUG_KEY_ALIAS=androiddebugkey
# DEBUG_KEYSTORE_PASSWORD=android
# DEBUG_KEY_PASSWORD=android

# --- PROD RELEASE KEYSTORE ---
PROD_RELEASE_KEYSTORE_FILE=release-keystore.jks
PROD_RELEASE_KEY_ALIAS=your_prod_key_alias
PROD_RELEASE_KEYSTORE_PASSWORD=your_prod_keystore_password
PROD_RELEASE_KEY_PASSWORD=your_prod_key_password

# --- DEV RELEASE KEYSTORE ---
DEV_RELEASE_KEYSTORE_FILE=dev-release.jks
DEV_RELEASE_KEY_ALIAS=your_dev_key_alias
DEV_RELEASE_KEYSTORE_PASSWORD=your_dev_keystore_password
DEV_RELEASE_KEY_PASSWORD=your_dev_key_password
