# ==============================================================================
# DozeTap Local Keystore Configuration
# Copy this file to 'keystore.properties' and fill in your actual credentials.
# 'keystore.properties' is gitignored and will never be committed.
# ==============================================================================

# --- DEBUG KEYSTORE (Optional custom debug signing credentials) ---
DEBUG_KEYSTORE_FILE=path/to/your/debug-keystore.jks
DEBUG_KEY_ALIAS=androiddebugkey
DEBUG_KEYSTORE_PASSWORD=android
DEBUG_KEY_PASSWORD=android

# --- RELEASE KEYSTORE (Used for production release builds) ---
RELEASE_KEYSTORE_FILE=path/to/your/release-keystore.jks
RELEASE_KEY_ALIAS=your_release_key_alias
RELEASE_KEYSTORE_PASSWORD=your_release_keystore_password
RELEASE_KEY_PASSWORD=your_release_key_password
